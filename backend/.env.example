PORT=4000
JWT_SECRET=replace-with-a-long-random-secret

# Sepolia RPC used by purchase listeners and receipt verification.
BLOCKCHAIN_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/replace-me
BLOCKCHAIN_CHAIN_ID=11155111

# New ImageAuthenticator deployment that requires backend approvals.
BLOCKCHAIN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
BLOCKCHAIN_CONTRACT_ABI_PATH=../smart_contract/artifacts/contracts/ImageAuthenticator.sol/ImageAuthenticator.json

# This key signs register/updatePrice/purchase approvals.
# The deployed contract constructor must receive this key's public address.
BACKEND_SIGNER_PRIVATE_KEY=0xreplace-me
